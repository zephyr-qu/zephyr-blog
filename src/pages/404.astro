---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Page Not Found">
  <main class="mx-auto flex max-w-prose flex-col items-center gap-6 py-20 text-center">
    <h1 class="font-heading text-6xl text-text-primary">404</h1>
    <p class="text-text-secondary">Page not found.</p>
    <a
      href="/"
      class="rounded-lg border border-border px-4 py-2 text-sm text-text-secondary transition-colors hover:border-border-hover hover:text-text-primary"
    >
      Go home
    </a>
  </main>
</Layout>
