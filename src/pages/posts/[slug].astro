---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { render } from 'astro:content';
import Layout from "@/layouts/Layout.astro";
import formatDate from "@/utils/formatDate";
import { getReadTime } from "@/utils/readTime";
import TableOfContents from "@/components/TableOfContents.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts");

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

type Props = {
  post: CollectionEntry<"posts">;
};

const { post } = Astro.props;

const rendered = await render(post).catch(() => null);
const Content = rendered?.Content;
const headings = rendered?.headings;

const toc = (headings ?? [])
  .filter((h) => h.depth === 2 || h.depth === 3)
  .filter((h) => h.text && h.slug);

const allPosts = (await getCollection("posts"))
  .filter((p) => p.data.isPublish && !p.data.isDraft && p.data.publishedAt <= new Date())
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());

// Related posts: up to 3 posts sharing at least one tag, excluding current
const relatedPosts = allPosts
  .filter((p) => {
    if (p.id === post.id) return false;
    const sharedTags = (p.data.tags ?? []).filter((t) => (post.data.tags ?? []).includes(t));
    return sharedTags.length > 0;
  })
  .slice(0, 3);
---

<Layout title={post.data.title} description={post.data.description}>
  <main class="mx-auto flex w-full max-w-4xl flex-col gap-8">
    <nav aria-label="Back to posts">
      <a
        href="/posts"
        class="group inline-flex items-center gap-1.5 text-sm text-text-secondary transition-colors hover:text-text-primary"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-200 group-hover:-translate-x-0.5">
          <line x1="5" y1="12" x2="19" y2="12" />
          <polyline points="12,5 5,12 12,19" />
        </svg>
        <span>Back to Posts</span>
      </a>
    </nav>

    <header role="presentation" class="flex flex-col gap-3">
      <h1 class="font-heading text-3xl text-text-primary">
        {post.data.title}
      </h1>

      <div class="flex flex-row flex-wrap items-center gap-2 text-sm text-text-secondary">
        <time>{formatDate(post.data.publishedAt)}</time>
        <span aria-hidden="true">·</span>
        <span>{getReadTime(post.body ?? "")}</span>
        {
          post.data.tags?.length > 0 && (
            <>
              <span aria-hidden="true">/</span>
              <ul role="list" class="flex flex-row flex-wrap gap-2">
                {post.data.tags.map((tag) => (
                  <li>
                    <a href={`/tags/${tag}`}
                      class="rounded-md bg-surface-code px-2 py-0.5 text-xs text-text-secondary transition-colors hover:bg-surface hover:text-text-primary">
                      {tag}
                    </a>
                  </li>
                ))}
              </ul>
            </>
          )
        }
      </div>

      <p class="italic text-text-secondary">{post.data.description}</p>

    </header>

    <article class="post flex flex-col gap-4">
      {Content ? <Content /> : <p>Failed to render post content.</p>}
    </article>

    {
      relatedPosts.length > 0 && (
        <section class="flex flex-col gap-6 border-t border-border pt-8">
          <h2 class="font-heading text-xl text-text-primary">Related posts</h2>
          <div class="flex flex-col gap-4">
            {relatedPosts.map((p) => (
              <a
                href={`/posts/${p.id}`}
                class="group flex flex-col gap-1 rounded-lg border border-border p-4 transition-all hover:border-border-hover hover:-translate-y-0.5"
              >
                <h3 class="font-heading text-text-primary">{p.data.title}</h3>
                <p class="text-sm text-text-secondary line-clamp-2">{p.data.description}</p>
                <div class="flex flex-row gap-2 text-xs text-text-secondary">
                  <time>{formatDate(p.data.publishedAt)}</time>
                  <span aria-hidden="true">·</span>
                  <span>{getReadTime(p.body ?? "")}</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </main>

  <TableOfContents toc={toc} />
</Layout>
