---
import type { TailwindColor } from "@/utils/types/tailwind";
import { MAP_COLOR_VARIANT_TO_BG } from "@/utils/mapVariants";

type Props = {
  position: "bottom" | "top";
  color: TailwindColor;
};

const { position, color } = Astro.props;
---

<div
  class:list={{
    [`fixed z-0 rounded-full ${MAP_COLOR_VARIANT_TO_BG[color]} opacity-60`]: true,
    ["-left-32 -top-32 h-[400px] w-[400px] blur-[120px]"]: position === "top",
    ["-right-32 -bottom-32 h-[400px] w-[400px] blur-[120px]"]: position === "bottom",
  }}
>
</div>
