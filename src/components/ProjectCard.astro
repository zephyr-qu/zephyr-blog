---
import type { Project } from "@/data/projects";

type Props = Project;

const { title, techs, link, badge, isComingSoon } = Astro.props;

const badgeClass = "bg-surface-secondary text-text-secondary border-border";
const formatTechs = (values: string[]) =>
  values.toString().replaceAll(",", " • ");
---

<>
  {
    isComingSoon && (
      <div class="t group flex w-full flex-col justify-between gap-2 rounded-md border border-border p-4 md:flex-row md:items-center">
        <div class="flex flex-col gap-2 md:flex-row md:items-center md:gap-4">
          <p class="font-heading text-text-primary">{title}</p>
          <p>{formatTechs(techs)}</p>
        </div>

        <p class="w-fit rounded-md bg-surface-secondary px-4 py-1">Soon</p>
      </div>
    )
  }

  {
    !isComingSoon && (
      <a
        class="group flex w-full cursor-pointer flex-col justify-between gap-2 rounded-md border border-border p-4 transition-all duration-300 hover:-translate-y-2 hover:border-border-hover md:flex-row md:items-center"
        href={link}
        target="_blank"
      >
        <div class="flex flex-col gap-4 md:flex-row md:items-center">
          <div class="flex items-center gap-3">
            <p class="font-heading text-text-primary">{title}</p>
            {
              badge && (
                <span class:list={["flex w-fit shrink-0 items-center gap-1.5 rounded-md border px-2.5 py-0.5 text-xs", badgeClass]}>
                  <span class="h-1.5 w-1.5 rounded-full bg-current" aria-hidden="true"></span>
                  {badge.text}
                </span>
              )
            }
          </div>
          <p>{formatTechs(techs)}</p>
        </div>

        <svg
          width="18"
          height="18"
          viewBox="0 0 18 18"
          fill="none"
          class="text-arrow transition-all duration-300 group-hover:translate-x-1"
        >
          <path
            d="M5.25 12.75L12.75 5.25"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <path
            d="M5.25 5.25H12.75V12.75"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
    )
  }
</>
