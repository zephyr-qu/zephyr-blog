---
type Props = {
  currentPage: number;
  totalPages: number;
};

const { currentPage, totalPages } = Astro.props;
---

{
  totalPages > 1 && (
    <nav class="flex flex-row items-center justify-center gap-2">
      {Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => (
        <a
          href={page === 1 ? "/posts" : `/posts/page/${page}`}
          class:list={{
            ["flex h-8 w-8 items-center justify-center rounded-md border text-sm transition-colors"]: true,
            ["border-border bg-surface text-text-primary"]: page === currentPage,
            ["border-border text-text-secondary hover:border-border-hover hover:text-text-primary"]: page !== currentPage,
          }}
        >
          {page}
        </a>
      ))}
    </nav>
  )
}
