{
  "name": "astro-template-portfolio",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@11.14.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "deploy": "pnpm run build && wrangler deploy",
    "preview": "pnpm run build && wrangler dev",
    "check": "astro check",
    "commit": "pi -p --no-extensions --no-skills --no-themes --tools read,bash \"分析当前 git 变更，生成符合 Conventional Commits 规范的提交信息，然后执行 git add、commit 并推送到远程仓库\"",
    "astro": "astro",
    "new-post": "node scripts/new-post.js"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.3",
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/rss": "^4.0.19",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.0",
    "astro-robots-txt": "^1.0.0",
    "astro-seo": "1.2.0",
    "rehype-slug": "^6.0.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@astrojs/cloudflare": "^14.4.0",
    "@types/hast": "^3.0.5",
    "typescript": "^6.0.3",
    "wrangler": "^4.151.2"
  }
}
